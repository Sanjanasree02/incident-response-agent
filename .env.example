# Copy this file to .env and fill in real values. Never commit .env.

# Hindsight Cloud (https://ui.hindsight.vectorize.io)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=replace-me
HINDSIGHT_BANK_ID=shopfast-incidents

# Groq (https://console.groq.com)
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b

# ShopFast mock app
SHOPFAST_HOST=127.0.0.1
SHOPFAST_PORT=8001

# Public deploy only (docs/DEPLOY.md). Leave unset locally.
# SHOPFAST_URL=https://shopfast-api.onrender.com   # wins over SHOPFAST_HOST / SHOPFAST_PORT
# SHOPFAST_ADMIN_TOKEN=                            # guards ShopFast's /admin and /ops
# UI_PASSWORD=                                     # shared password in front of the UI
# DEMO_CONTROLS=1                                  # "break the shop" panel in the UI
# STOREFRONT_URL=https://shopfast-storefront.onrender.com

# REST API (api/app.py): clients send this in the X-API-Key header. Use a long random value.
AGENT_API_KEY=replace-me

# SQLite file for open incidents (UI, API and MCP). Optional; default data/incidents.db
# INCIDENT_DB=data/incidents.db
