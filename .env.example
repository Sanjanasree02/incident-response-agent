# Copy this file to .env and fill in real values. Never commit .env.

# Hindsight Cloud (https://ui.hindsight.vectorize.io)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=replace-me
HINDSIGHT_BANK_ID=shopfast-incidents

# Groq (https://console.groq.com)
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b

# ShopFast mock app
SHOPFAST_HOST=127.0.0.1
SHOPFAST_PORT=8001

# REST API (api/app.py): clients send this in the X-API-Key header. Use a long random value.
AGENT_API_KEY=replace-me

# SQLite file for open incidents (UI, API and MCP). Optional; default data/incidents.db
# INCIDENT_DB=data/incidents.db
